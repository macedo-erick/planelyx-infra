# Reference only. `.github/workflows/deploy.yml` renders the real `.env` on the VPS from this
# repo's secrets on every run, and hand edits on the box are reverted by the next deploy.
# See VPS_SETUP.md §13 for what each value is and where it comes from.
#
# Compose eats an unquoted `$` and its dotenv parser has no escape for `'`. The workflow
# renders every credential single-quoted and rejects any secret containing a single quote.
# `openssl rand -base64 32` emits neither.

REGISTRY=southamerica-east1-docker.pkg.dev/CHANGE_ME_PROJECT_ID/planelyx
API_TAG=CHANGE_ME
UI_TAG=CHANGE_ME
OCR_TAG=CHANGE_ME

APP_DB_PASSWORD=CHANGE_ME
OCR_DB_PASSWORD=CHANGE_ME

# Shared with the auth repo — both repos must hold the same value.
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME
PLANELYX_PROVISIONING_SECRET=CHANGE_ME

OCR_LLM_ENABLED=false
OCR_LLM_PARSE_MODE=fallback
OCR_LLM_MONTHLY_CEILING_USD=10
ANTHROPIC_API_KEY=

API_LOG_LEVEL=INFO
API_LOG_LEVEL_ROOT=INFO
OCR_LOG_LEVEL=info
