# Copy to .env on the VPS, fill in, and chmod 600.
#
# Every value below must be freshly generated. None of the local dev credentials
# (planelyx/planelyx, admin/admin) may be reused here.
#
# ⚠️ A LITERAL `$` IN AN UNQUOTED VALUE IS SILENTLY EATEN. Compose interpolates $NAME inside
# this file, so an unquoted password of `Ab$xK9zQ` reaches the container as just `Ab`. The
# only hint is a WARN line about an unset variable; the failure then surfaces much later as
# a database connection timeout that looks nothing like a credential problem.
#
#   KC_DB_PASSWORD=Ab$xK9zQ       ->  Ab          WRONG
#   KC_DB_PASSWORD='Ab$xK9zQ'     ->  Ab$xK9zQ    ok  (simplest)
#   KC_DB_PASSWORD=Ab$$xK9zQ      ->  Ab$xK9zQ    ok  ($$ is Compose syntax, not the password)
#
# `openssl rand -base64 32` never emits `$`, which sidesteps this entirely.
#
# Verify what the container actually receives — `docker compose config` re-escapes `$` and
# will mislead you here:
#   docker compose -f compose.prod.yaml run --rm auth printenv KC_DB_PASSWORD

# --- Images -----------------------------------------------------------------
# Artifact Registry path, no trailing slash and no image name. The repository segment must
# match `REPOSITORY` in the three release.yml workflows — they push to `docker-remote-repo`,
# so pointing this anywhere else makes `deploy.sh` pull from a path CI never wrote to.
REGISTRY=southamerica-east1-docker.pkg.dev/CHANGE_ME_PROJECT_ID/docker-remote-repo

# Pin exact commit SHAs rather than `latest`, so a redeploy is reproducible and a
# rollback is just editing these three lines.
API_TAG=CHANGE_ME
UI_TAG=CHANGE_ME
AUTH_TAG=CHANGE_ME

# --- Database ---------------------------------------------------------------
# Passwords for the two roles created in Phase 5. Two roles, two databases, one server.
APP_DB_PASSWORD=CHANGE_ME
KC_DB_PASSWORD=CHANGE_ME

# --- Keycloak bootstrap admin ------------------------------------------------
# Applied on first boot only. Consider creating a named admin in the console afterwards
# and disabling this one.
KC_ADMIN=CHANGE_ME
KC_ADMIN_PASSWORD=CHANGE_ME
