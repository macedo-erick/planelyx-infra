# Copy to .env on the VPS, fill in, and chmod 600.
#
# ⚠️ AFTER THE FIRST DEPLOY, `.env` IS RENDERED BY `.github/workflows/deploy.yml` FROM REPO
# SECRETS. Hand edits on the VPS are overwritten on the next deploy. Rotate a credential by
# updating the repo secret and re-running the workflow with "Allow DB/Keycloak credentials to
# differ" ticked — changing it only on the box makes the workflow fail its drift check, which
# is the intended behaviour rather than a bug. This file remains the reference for what the
# keys mean, and the bootstrap path for the very first deploy.
#
# Every value below must be freshly generated. None of the local dev credentials
# (planelyx/planelyx, admin/admin) may be reused here.
#
# ⚠️ A LITERAL `$` IN AN UNQUOTED VALUE IS SILENTLY EATEN. Compose interpolates $NAME inside
# this file, so an unquoted password of `Ab$xK9zQ` reaches the container as just `Ab`. The
# only hint is a WARN line about an unset variable; the failure then surfaces much later as
# a database connection timeout that looks nothing like a credential problem.
#
#   KC_DB_PASSWORD=Ab$xK9zQ       ->  Ab          WRONG
#   KC_DB_PASSWORD='Ab$xK9zQ'     ->  Ab$xK9zQ    ok  (simplest)
#   KC_DB_PASSWORD=Ab$$xK9zQ      ->  Ab$xK9zQ    ok  ($$ is Compose syntax, not the password)
#
# `openssl rand -base64 32` never emits `$`, which sidesteps this entirely.
#
# The corollary: single quotes are the only interpolation-proof form, and Compose's dotenv
# parser is not a shell, so it has no `'\''` escape — a value simply cannot contain a single
# quote. The deploy workflow renders every credential single-quoted and rejects any secret
# containing `'`. `openssl rand -base64 32` doesn't emit one of those either.
#
# Verify what the container actually receives — `docker compose config` re-escapes `$` and
# will mislead you here:
#   docker compose -f compose.prod.yaml run --rm auth printenv KC_DB_PASSWORD

# --- Images -----------------------------------------------------------------
# Artifact Registry path, no trailing slash and no image name. The repository segment must
# match `REPOSITORY` in the four release.yml workflows — they push to `planelyx`, and
# deploy.yml renders the same value, so pointing this anywhere else makes the first manual
# `docker compose pull` read from a path CI never wrote to.
REGISTRY=southamerica-east1-docker.pkg.dev/CHANGE_ME_PROJECT_ID/planelyx

# Pin exact commit SHAs rather than `latest`, so a redeploy is reproducible and a
# rollback is just editing these four lines.
API_TAG=CHANGE_ME
UI_TAG=CHANGE_ME
AUTH_TAG=CHANGE_ME
OCR_TAG=CHANGE_ME

# --- Database ---------------------------------------------------------------
# Passwords for the three roles created in Phase 5. Three roles, three databases, one server.
APP_DB_PASSWORD=CHANGE_ME
KC_DB_PASSWORD=CHANGE_ME

# The `planelyx_ocr` role, which owns the ingestion database — staged extractions and the
# metadata for the encrypted originals on disk. A role of its own rather than reusing
# `planelyx_app` for the same reason `keycloak` has one: this service accepts uploaded files
# from the internet, and a compromise of it should not carry a credential to the ledger.
OCR_DB_PASSWORD=CHANGE_ME

# --- Keycloak bootstrap admin ------------------------------------------------
# Applied on first boot only. Consider creating a named admin in the console afterwards
# and disabling this one.
KC_ADMIN=CHANGE_ME
KC_ADMIN_PASSWORD=CHANGE_ME

# --- Keycloak admin API client ------------------------------------------------
# Secret of the confidential `planelyx-api-admin` client, which the API uses to read and
# update the signed-in user's own profile (/me) through Keycloak's Admin API.
#
# Unlike everything else here, this value is NOT generated — it is read from Keycloak.
# The client is created in the admin console (Clients -> planelyx-api-admin -> Credentials),
# because the realm export only ever applies on a realm's first import. Copy the secret from
# there; generating a fresh one here would simply not match, and the API would 401.
#
# Its service account also needs the realm-management roles `view-users` and `manage-users`,
# which a newly created client does not get by default — without them the API gets 403
# instead of 401, same broken endpoint.
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME

# --- User provisioning callback ----------------------------------------------
# Shared secret between Keycloak's `planelyx-provisioning` event listener, which signs the
# "a user registered" callback with it, and the API, which refuses the callback unless the
# signature matches. That callback is what gives a new user their default categories.
#
# Unlike the client secret above, this one IS yours to generate — nothing reads it back out
# of Keycloak. Any long random string will do:
#
#   openssl rand -hex 32
#
# One key feeds both containers, so the two sides cannot drift. Rotating it means restarting
# both together; between the restarts, callbacks are rejected and users registering in that
# window get no categories.
#
# The listener also has to be switched on for the realm, once, by hand: admin console ->
# Realm settings -> Events -> Event listeners -> add `planelyx-provisioning`. The realm export
# names it, but --import-realm skips a realm that already exists.
PLANELYX_PROVISIONING_SECRET=CHANGE_ME
